    "components": {
        "schemas": {
            "SkipRequest": {
                "required": [
                    "taskId",
                    "userId"
                ],
                "type": "object",
                "properties": {
                    "taskId": {
                        "type": "integer",
                        "description": "\u4efb\u52a1 ID\uff08FlowLong \u96ea\u82b1 long\uff09",
                        "format": "int64",
                        "example": 2056368596446793733
                    },
                    "userId": {
                        "type": "string",
                        "description": "\u64cd\u4f5c\u4eba staff_uuid",
                        "example": "10011"
                    },
                    "userName": {
                        "type": "string",
                        "description": "\u64cd\u4f5c\u4eba\u663e\u793a\u540d",
                        "example": "Alice"
                    },
                    "message": {
                        "type": "string",
                        "description": "\u5ba1\u6279\u610f\u89c1",
                        "example": "\u540c\u610f\uff0c\u7b26\u5408\u91c7\u8d2d\u89c4\u8303"
                    },
                    "variables": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "object",
                            "description": "\u8282\u70b9\u6d41\u8f6c\u53d8\u91cf\uff1a\u53ef\u7528 approverIds \u6307\u5b9a\u4e0b\u4e00\u8282\u70b9\u5ba1\u6279\u4eba list\uff08caller \u9884\u89e3\u6790\u540e\u4f20\u5165\uff09\u3002\u4f20 null \u65f6\u4f7f\u7528\u542f\u52a8\u65f6\u5df2\u4f20\u7684 approverIds\u3002"
                        },
                        "description": "\u8282\u70b9\u6d41\u8f6c\u53d8\u91cf\uff1a\u53ef\u7528 approverIds \u6307\u5b9a\u4e0b\u4e00\u8282\u70b9\u5ba1\u6279\u4eba list\uff08caller \u9884\u89e3\u6790\u540e\u4f20\u5165\uff09\u3002\u4f20 null \u65f6\u4f7f\u7528\u542f\u52a8\u65f6\u5df2\u4f20\u7684 approverIds\u3002"
                    }
                },
                "description": "\u5ba1\u6279\u901a\u8fc7\u8bf7\u6c42\u4f53\u3002caller \u53ef\u901a\u8fc7 variables.approverIds \u6307\u5b9a\u4e0b\u4e00\u8282\u70b9\u7684\u4eba"
            },
            "SkipResponse": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "description": "\u5f15\u64ce\u662f\u5426\u6210\u529f\u63a8\u8fdb",
                        "example": true
                    },
                    "currentNodeKey": {
                        "type": "string",
                        "description": "\u64cd\u4f5c\u540e\u5b9e\u4f8b\u5f53\u524d\u8282\u70b9 key\uff08\u6d41\u7a0b\u7ed3\u675f\u5219\u4e3a end\uff09",
                        "example": "approve"
                    },
                    "instanceState": {
                        "type": "integer",
                        "description": "\u5b9e\u4f8b\u72b6\u6001\uff1a0=\u5ba1\u6279\u4e2d 1=\u5ba1\u6279\u901a\u8fc7 2=\u5ba1\u6279\u62d2\u7edd 3=\u64a4\u9500 5=\u7ec8\u6b62",
                        "format": "int32",
                        "example": 0
                    }
                },
                "description": "\u5ba1\u6279/\u901a\u8fc7\u4efb\u52a1\u8fd4\u56de"
            },
            "RejectRequest": {
                "required": [
                    "reason",
                    "taskId",
                    "userId"
                ],
                "type": "object",
                "properties": {
                    "taskId": {
                        "type": "integer",
                        "description": "\u4efb\u52a1 ID",
                        "format": "int64",
                        "example": 2056368596446793733
                    },
                    "userId": {
                        "type": "string",
                        "description": "\u64cd\u4f5c\u4eba staff_uuid",
                        "example": "10011"
                    },
                    "userName": {
                        "type": "string",
                        "description": "\u64cd\u4f5c\u4eba\u663e\u793a\u540d",
                        "example": "Alice"
                    },
                    "reason": {
                        "type": "string",
                        "description": "\u9a73\u56de\u539f\u56e0\uff08\u5fc5\u586b\uff0c\u4e1a\u52a1\u89c4\u5219\uff09",
                        "example": "\u91d1\u989d\u4e0d\u7b26\uff0c\u8bf7\u4fee\u6539"
                    },
                    "rejectToNodeKey": {
                        "type": "string",
                        "description": "\u9a73\u56de\u5230\u6307\u5b9a\u8282\u70b9 key\uff08null/\u7559\u7a7a\u5219\u9a73\u56de\u5230\u4e0a\u4e00\u8282\u70b9\uff09",
                        "example": "submit"
                    },
                    "terminate": {
                        "type": "boolean",
                        "description": "\u662f\u5426\u540c\u65f6\u7ec8\u6b62\u6574\u4e2a\u5b9e\u4f8b\uff08true=\u7ec8\u6b62\uff0c\u4e1a\u52a1'\u9a73\u56de'\u5206\u652f\u7528\uff1bfalse=\u4ec5\u9000\u56de\u524d\u4e00\u8282\u70b9\uff0c\u9ed8\u8ba4 false\uff09",
                        "example": false
                    }
                },
                "description": "\u9a73\u56de\u4efb\u52a1\u8bf7\u6c42\u4f53"
            },
            "ActorInfo": {
                "type": "object",
                "properties": {
                    "actorId": {
                        "type": "string"
                    },
                    "actorName": {
                        "type": "string"
                    },
                    "actorType": {
                        "type": "integer",
                        "description": "0=\u7528\u6237 1=\u89d2\u8272 2=\u90e8\u95e8",
                        "format": "int32"
                    }
                }
            },
            "RejectResponse": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "activatedTasks": {
                        "type": "array",
                        "description": "\u9a73\u56de\u540e\u6fc0\u6d3b\u7684\u4efb\u52a1\u5217\u8868\uff08\u5982\u679c\u662f\u9000\u56de\u4e0a\u4e00\u8282\u70b9\u4f1a\u6709\u65b0\u4efb\u52a1\uff1b\u5982\u679c\u662f\u7ec8\u6b62\u5219\u4e3a\u7a7a\uff09",
                        "items": {
                            "$ref": "#/components/schemas/TaskInfo"
                        }
                    },
                    "instanceState": {
                        "type": "integer",
                        "description": "\u5b9e\u4f8b\u72b6\u6001",
                        "format": "int32",
                        "example": 0
                    }
                },
                "description": "\u9a73\u56de\u54cd\u5e94"
            },
            "TaskInfo": {

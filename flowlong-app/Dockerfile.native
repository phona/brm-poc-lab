# Runtime-only Dockerfile：假设 target/flowlong-app 已由 CI workflow 编好。
# 不在镜像内 build，避免重复 + native build 对内存/磁盘的高要求。
#
# 本地手动 build 流程：
#   cd flowlong-app
#   mvn -Pnative -DskipTests package      # 需要本机已装 GraalVM 17
#   docker build -f Dockerfile.native -t flowlong-app:native .

# distroless/cc：自带 glibc + libz + libstdc++（base-debian12 缺 libz，native binary 跑不起来）
FROM gcr.io/distroless/cc-debian12:nonroot

WORKDIR /app
COPY target/flowlong-app /app/flowlong-app

EXPOSE 8082
USER nonroot:nonroot
ENTRYPOINT ["/app/flowlong-app"]

# Runtime-only Dockerfile：假设 target/flowlong-app 已由 CI workflow 编好。
# 不在镜像内 build，避免重复 + native build 对内存/磁盘的高要求。
#
# 本地手动 build 流程：
#   cd flowlong-app
#   mvn -Pnative -DskipTests package      # 需要本机已装 GraalVM 17
#   docker build -f Dockerfile.native -t flowlong-app:native .

# debian:12-slim：~80MB，含 libz + libc + libstdc++ 等完整运行时
# (distroless/cc-debian12 验证发现不含 libz，native binary 启动报 cannot open libz.so.1)
FROM debian:12-slim

# 只装 binary 必需的，去 apt 缓存
RUN apt-get update && apt-get install -y --no-install-recommends \
    zlib1g ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r app && useradd -r -g app -u 10001 app

WORKDIR /app
COPY target/flowlong-app /app/flowlong-app
RUN chmod +x /app/flowlong-app

EXPOSE 8082
USER app:app
ENTRYPOINT ["/app/flowlong-app"]
